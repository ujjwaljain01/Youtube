{
	"project": {
		"name": "NovaPlay",
		"type": "Full Stack Video Sharing Platform",
		"frontend": {
			"framework": "React 19",
			"bundler": "Vite",
			"language": "TypeScript",
			"styling": "Tailwind CSS v4",
			"ui": "shadcn/ui",
			"icons": "@phosphor-icons/react",
			"animations": "Motion",
			"state": "Zustand",
			"routing": "React Router v7",
			"videoPlayer": "VidStack (Watch Page only)",
			"http": "Axios",
			"serverState": "TanStack Query (planned)"
		},
		"backend": {
			"framework": "Express.js",
			"database": "MongoDB",
			"orm": "Mongoose",
			"storage": "Cloudinary",
			"authentication": "JWT + Cookies"
		}
	},

	"designPhilosophy": {
		"overall": [
			"Production-grade architecture",
			"Feature-oriented organization",
			"Reusable components",
			"Composable UI",
			"Data-driven rendering",
			"Strong TypeScript typing",
			"Avoid premature abstraction",
			"UI-first before API integration"
		],
		"principles": [
			"Separate UI state from server state",
			"Keep components small and focused",
			"Prefer composition over inheritance",
			"Build reusable primitives first",
			"Avoid duplicated layout logic",
			"Backend responses should be transformed into frontend models"
		]
	},

